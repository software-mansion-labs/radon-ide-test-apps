source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'

# json 3.x dropped the `quirks_mode` option that activesupport (< 8.1) still
# passes to JSON.generate. On any machine where json 3.x is installed, a plain
# `pod install` then crashes with "ArgumentError - unknown keyword: quirks_mode"
# inside expo-modules-autolinking's sandbox.rb. Radon uses `bundle exec pod`
# whenever a Gemfile is present, so this pin keeps the CI runner on json 2.x.
gem 'json', '< 3'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
